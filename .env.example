# Copy to `.env` for local development. NEVER commit the real `.env`.
# Spring Boot imports this file via spring.config.import=optional:file:.env[.properties]

# --- Database ---
DB_URL=db_url
DB_USERNAME=db_user
DB_PASSWORD=db_pass

# --- Mail (SMTP) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=mail@username
MAIL_PASSWORD=mail_pass

# --- Security / tokenization ---
# Generate strong random values, e.g. `openssl rand -base64 48`
PII_ENCRYPTION_KEY=key
PII_HASH_KEY=key
OTP_HASH_KEY=key
JWT_ISSUER=sondhan
JWT_ACCESS_TOKEN_VALIDITY=1200
JWT_REFRESH_TOKEN_VALIDITY=604800
# Unsuccessful attempts allowed per client IP, resolved user id and (for OTP)
# purpose in a 5-minute window.
AUTH_FAILURE_MAX_ATTEMPTS=10
AUTH_FAILURE_WINDOW_MINUTES=5

# Paths to PKCS#8 private key and X.509 public key files (outside the repo).
# Leave empty to generate an ephemeral development key pair (tokens are lost on restart).
RSA_PRIVATE_KEY_PATH=
RSA_PUBLIC_KEY_PATH=

# --- Infrastructure ---
REDIS_CLUSTER_NODES=
REDIS_PASSWORD=
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_SCHEME=http

# --- CORS ---
CORS_ORIGIN_1=http://localhost:3000
CORS_ORIGIN_2=http://localhost:3001
CORS_ORIGIN_3=http://localhost:3002

# Set to false in production to disable Swagger/OpenAPI.
SPRINGDOC_ENABLED=true
