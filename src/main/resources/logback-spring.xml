<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!--
      LOG_DIR can be overridden with a system property or environment variable
      (the container image sets -DLOG_DIR=/var/log/sondhan). Keeping the
      fallback here preserves the local `logs/` directory for host runs.
    -->
    <property name="APP_NAME" value="blood-donor-finder"/>

    <appender name="CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">

        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS}
                [%thread]
                %-5level
                %logger{36}
                [%X{requestId}]
                - %msg%n
            </pattern>
        </encoder>

    </appender>


    <appender name="APP_FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR:-logs}/application.log</file>
        <rollingPolicy
                class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>
                ${LOG_DIR:-logs}/archive/application.%d{yyyy-MM-dd}.%i.log.gz
            </fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>5GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS}
                [%thread]
                %-5level
                %logger{40}
                [%X{requestId}]
                - %msg%n
            </pattern>
        </encoder>
    </appender>



    <appender name="ERROR_FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>${LOG_DIR:-logs}/error.log</file>

        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>

        <rollingPolicy
                class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">

            <fileNamePattern>
                ${LOG_DIR:-logs}/archive/error.%d{yyyy-MM-dd}.%i.log.gz
            </fileNamePattern>

            <maxFileSize>50MB</maxFileSize>

            <maxHistory>90</maxHistory>

            <totalSizeCap>2GB</totalSizeCap>

        </rollingPolicy>

        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS}
                [%thread]
                %-5level
                %logger{40}
                - %msg%n
            </pattern>
        </encoder>

    </appender>


    <appender name="KAFKA_FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>${LOG_DIR:-logs}/kafka.log</file>

        <rollingPolicy
                class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">

            <fileNamePattern>
                ${LOG_DIR:-logs}/archive/kafka.%d{yyyy-MM-dd}.%i.log.gz
            </fileNamePattern>

            <maxFileSize>50MB</maxFileSize>

            <maxHistory>30</maxHistory>

        </rollingPolicy>

        <encoder>

            <pattern>
                %d %-5level %logger - %msg%n
            </pattern>

        </encoder>

    </appender>


    <!--
      Logstash is optional developer/observability infrastructure. The appender
      is only attached when the `logstash` Spring profile is active, so a plain
      local run no longer retries a dead localhost:5000 connection every 30s.
      Enable with SPRING_PROFILES_ACTIVE=dev,logstash (and optionally override
      LOGSTASH_DESTINATION, e.g. logstash:5000 inside Compose).
    -->
    <springProperty scope="context" name="LOGSTASH_DESTINATION"
                    source="LOGSTASH_DESTINATION" defaultValue="localhost:5000"/>
    <springProperty scope="context" name="LOGSTASH_ENVIRONMENT"
                    source="LOGSTASH_ENVIRONMENT" defaultValue="development"/>

    <appender name="LOGSTASH"
              class="net.logstash.logback.appender.LogstashTcpSocketAppender">

        <destination>${LOGSTASH_DESTINATION}</destination>

        <encoder
                class="net.logstash.logback.encoder.LogstashEncoder">

            <customFields>
                {
                "application":"blood-donor-finder",
                "environment":"${LOGSTASH_ENVIRONMENT}"
                }
            </customFields>

        </encoder>

    </appender>



    <logger name="org.apache.kafka"
            level="INFO"
            additivity="false">

        <appender-ref ref="KAFKA_FILE"/>

    </logger>

    <logger name="org.springframework"
            level="INFO"/>


    <logger name="org.hibernate"
            level="WARN"/>


    <logger name="com.bd.blooddonorfinder"
            level="DEBUG"/>


    <!--
      Default: console + rolling files only. Logstash is optional
      observability infrastructure, so the appender is not attached unless
      the `logstash` profile is explicitly enabled.
    -->
    <springProfile name="!logstash">

        <root level="INFO">

            <appender-ref ref="CONSOLE"/>

            <appender-ref ref="APP_FILE"/>

            <appender-ref ref="ERROR_FILE"/>

        </root>

    </springProfile>

    <!-- Enable with SPRING_PROFILES_ACTIVE=dev,logstash (Compose: logstash:5000). -->
    <springProfile name="logstash">

        <root level="INFO">

            <appender-ref ref="CONSOLE"/>

            <appender-ref ref="APP_FILE"/>

            <appender-ref ref="ERROR_FILE"/>

            <appender-ref ref="LOGSTASH"/>

        </root>

    </springProfile>

</configuration>