# ---------------------------------------------------------------------------
# Production environment for Docker Compose.
#
#   cp Docker/prod.env.example Docker/prod.env
#   chmod 600 Docker/prod.env
#
# This file holds non-secret configuration only. Passwords and cryptographic
# keys are mounted as Docker secrets from Docker/secrets/ (see README there).
#
# For managed services, point DB_URL / KAFKA_BOOTSTRAP_SERVERS /
# ELASTICSEARCH_* / REDIS_CLUSTER_NODES at the managed endpoints and remove the
# --profile self-hosted-infra flag.
# ---------------------------------------------------------------------------

# --- Application ---
# Image built and pushed by CI, e.g. registry.example.com/sondhan/blood-donor-finder
APP_IMAGE=sondhan-app
APP_TAG=latest
# Loopback port used by the host reverse proxy. Not reachable from the internet.
APP_PORT=8088
APP_MEM_LIMIT=1g
APP_CPUS=2.0
# Never expose Swagger/OpenAPI in production.
SPRINGDOC_ENABLED=false
SPRING_PROFILES_ACTIVE=prod

# --- PostgreSQL ---
DB_NAME=bd_db
DB_USERNAME=bduser
# Self-hosted default. For managed PostgreSQL use the provider endpoint, e.g.
# jdbc:postgresql://db.example.internal:5432/bd_db?sslmode=require
DB_URL=jdbc:postgresql://postgres:5432/bd_db
# DB_PASSWORD comes from Docker/secrets/db_password (do not put it here).

# --- Mail (SMTP) ---
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=no-reply@example.com
# MAIL_PASSWORD comes from Docker/secrets/mail_password.
# EMAIL_PAYLOAD_KEY comes from Docker/secrets/email_payload_key.

# --- Security / tokenization ---
JWT_ISSUER=sondhan
JWT_ACCESS_TOKEN_VALIDITY=1200
JWT_REFRESH_TOKEN_VALIDITY=604800
AUTH_FAILURE_MAX_ATTEMPTS=10
AUTH_FAILURE_WINDOW_MINUTES=5
# PII_ENCRYPTION_KEY, PII_HASH_KEY, OTP_HASH_KEY are Docker secrets.
# RSA key paths default to the mounted secret files in docker-compose.prod.yml.
# RSA_PRIVATE_KEY_PATH=/run/secrets/rsa_private.pem
# RSA_PUBLIC_KEY_PATH=/run/secrets/rsa_public.pem

# --- Kafka ---
# Self-hosted KRaft broker. Managed example: broker-1:9092,broker-2:9092
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# --- Elasticsearch ---
# Self-hosted single node. Managed example: https + credentials in the URL.
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_SCHEME=http

# --- Redis ---
# Self-hosted cluster masters. Managed example: redis.example.internal:6379
REDIS_CLUSTER_NODES=redis-1:6379,redis-3:6379,redis-5:6379
# REDIS_PASSWORD can be added here if the cluster requires AUTH; keep it in a
# secret if the deployment supports it.
REDIS_PASSWORD=

# --- Document storage (MinIO / S3-compatible) ---
# Point at a managed bucket service, or run MinIO separately and set these.
# Keep the secret in Docker/secrets when the deployment supports it.
MINIO_ENDPOINT=https://objects.example.internal
MINIO_ACCESS_KEY=
# Supply MINIO_SECRET_KEY through your secret manager / environment.
MINIO_SECRET_KEY=
MINIO_PRESIGN_TTL=300

# --- CORS ---
# Exact origins of the deployed frontend(s). Empty entries are not allowed.
CORS_ORIGIN_1=https://app.example.com
CORS_ORIGIN_2=https://admin.example.com
CORS_ORIGIN_3=

# --- Self-hosted infrastructure tuning (ignored when using managed services) ---
POSTGRES_MEM_LIMIT=1g
KAFKA_MEM_LIMIT=1g
ES_MEM_LIMIT=2g
REDIS_NODE_MEM_LIMIT=512m
# Must stay stable for the lifetime of the Kafka volume.
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
